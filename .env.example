DOCKER_NODEJS_PORT=3024

# Optional: the site's public address, such as https://example.com, for canonical links, the sitemap and social
# cards. When unset, the address of each request is used.
# NUXT_PUBLIC_SITE_URL=

# Optional: an email address or URL identifying who runs the Wikipedia data sync, as Wikimedia asks.
# WIKIMEDIA_CONTACT=
